# RANE'S SANSKAR CLASSES - PRODUCTION ENGINE PROFILE

# Public Supabase endpoint values. These are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-public-anon-or-publishable-key

# Server-only Supabase credential. Never expose this in client components.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

# Local development convention.
PORT=3001
